<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Test run settings file for Elasticsearch integration tests.
  This file configures environment variables needed for test execution.
  
  Usage:
    Visual Studio: Test > Configure Run Settings > Select Solution Wide runsettings File
    dotnet test: dotnet test -settings:.runsettings
  
  Configuration Required:
    1. Set ELASTIC_SETTINGS_PATH to the full path of your local settings.json file
       Example: C:\Users\YourName\elasticsearch-settings\settings.json
    2. Ensure the settings.json file exists and contains valid Elasticsearch connection details
-->
<RunSettings>
  <RunConfiguration>
    <!-- Test execution settings -->
    <MaxCpuCount>1</MaxCpuCount>
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    <TargetPlatform>x64</TargetPlatform>
  </RunConfiguration>

  <!-- MSTest configuration -->
  <MSTest>
    <Parallelize>
      <Workers>1</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>

  <!-- Environment variables for tests -->
  <RunConfiguration>
    <EnvironmentVariables>
      <Variable name="ELASTIC_SETTINGS_PATH" value="C:\Source\saltminer-internal\config\elastic-client-integration-tests\settings.json" />
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
