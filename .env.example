#######################################################################################################################
# Settings that MUST be changed for your environment
#######################################################################################################################

# Example connection strings:
# ELASTICSEARCH_CONNECTION_STRING="Host=localhost;Port=9200;Scheme=http;Username=elastic;Password=changeme;SslVerify=true"
# ELASTICSEARCH_CONNECTION_STRING="CloudID=my-deployment:hexcode;Username=elastic;Password=change me;SslVerify=false"
# ELASTICSEARCH_CONNECTION_STRING="CloudID=my-deployment:hexcode;ApiKeyId=elastic;ApiKeyValue=morehexcode;SslVerify=false"
ELASTICSEARCH_CONNECTION_STRING="Host=elasticsearch;Port=9200;Scheme=https;Username=elastic;Password=changeme;SslVerify=true"
# Kibana URL should be the same inside and outside of the container network or you may have auth problems with the UI.
KIBANA_URL=http://kibana:5601
KIBANA_HOST=kibana


#######################################################################################################################
# Settings that CAN be changed
#######################################################################################################################

# Saltminer app root - persistent config, logs and data are stored in 
# this location.  Absolute or relative paths work; absolute 
# app root must exist or the stack will fail to initialize.
# Suggested paths: '/opt/saltworks' (default), '.' for current dir
APP_ROOT=/opt/saltworks

# Container image versions to use.
SM_API_IMAGE_VERSION=api-3.5
SM_UI_API_IMAGE_VERSION=ui-api-3.5
SM_NGINX_IMAGE_VERSION=sm-nginx-3.5
SM_JOBMANAGER_IMAGE_VERSION=jobmanager-3.5
SM_SERVICES_IMAGE_VERSION=services-3.5

# Memory limits are expressed in bytes.
# See https://docs.docker.com/reference/compose-file/extension/#specifying-byte-values
# sm_services container memory limit - increase if servicemanager or python loads are heavy.
SERVICES_MEMORY_LIMIT=1gb
# api container memory limit - increase if API load is heavy.
API_MEMORY_LIMIT=1gb

# Set ELK stack version if using elastic agent (leave commented if not)
#STACK_VERSION=9.4.2
# Additional settings if using elastic agent:
#ENROLLMENT_TOKEN=
#FLEET_SERVER_URL=


#######################################################################################################################
# Settings that SHOULD NOT be changed unless you know what you're doing
#######################################################################################################################

# https://docs.docker.com/compose/reference/envvars/#compose_project_name
COMPOSE_PROJECT_NAME=sm
CONTAINER_NETWORK=saltminer
CONTAINER_REGISTRY=docker.io
CONTAINER_APP_ROOT=/opt/saltworks/saltminer

# Host ports nginx publishes.  Docker: leave commented (defaults 80/443).
# Rootless PODMAN cannot bind ports <1024 - uncomment the high ports and
# forward 80->8080 / 443->8443 with the host firewall (see PODMAN.MD).
#NGINX_HTTP_PORT=8080
#NGINX_HTTPS_PORT=8443

# CONTAINER_UID_GID is the uid:gid the app containers (all but nginx) run as.
# Comment this line for Podman.
CONTAINER_UID_GID=10000:10001
# INIT_CHOWN is the uid:gid the init container chowns the app tree to so 
# those services can write their bind mounts.
# Comment this line for Podman.
INIT_CHOWN=10000:10001

ELASTIC_AGENT_HOSTNAME=saltminer-elastic-agent