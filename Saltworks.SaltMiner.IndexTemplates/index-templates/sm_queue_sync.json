{
    "index_patterns": [
        "sm_queue_sync*"
    ],
    "template": {
        "settings": {
            "number_of_shards": 1,
            "number_of_replicas": 0,
            "analysis": {
                "normalizer": {
                    "lc_normalizer": {
                        "type": "custom",
                        "char_filter": [],
                        "filter": [
                            "lowercase",
                            "asciifolding"
                        ]
                    }
                }
            }
        },
        "mappings": {
            "properties": {
                "data": { 
                    "properties": {
                        "target_id": { "type": "keyword" },
                        "target_type": { "type": "keyword" },
                        "target_instance": { "type": "keyword" },
                        "force": { "type": "boolean" }
                    }
                 }
            }
        }
    }
}