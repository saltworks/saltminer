{
  "index_patterns": ["sys_config*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "keyword"
        },
        "value_type": {
          "type": "keyword"
        },
        "section": {
          "type": "keyword"
        },
        "subsection": {
          "type": "keyword"
        },
        "property": {
          "type": "keyword"
        },
        "description": {
          "type": "text"
        },
        "label": {
          "type": "text"
        },
        "value": {
          "type": "text"
        },
        "timestamp": {
          "type": "date"
        },
        "last_updated": {
          "type": "date"
        }
      }
    }
  },
  "_meta": {
    "description": "Template for sys_config index"
  }
}