{
  "ServiceManagerConfig": {
    "EncryptionKey": "",
    "EncryptionIv": "",
    "DataApiBaseUrl": "http://api:5000",
    "DataApiVerifySsl": "true",
    "DataApiKey": "servicemanagersecret",
    "DataApiKeyHeader": "Authorization",
    "DataApiTimeoutSec": 60000,
    "AllowedExecutables": {
      "Agent25Cron": "/opt/saltworks/saltminer/scripts/agentcron25.sh",
      "AgentCron": "/opt/saltworks/saltminer/scripts/agentcron.sh",
      "ManagerCron": "/opt/saltworks/saltminer/scripts/managercron.sh",
	    "RiskRoller": "/opt/saltworks/saltminer/scripts/riskrollercron.sh",
      "PythonAgent": "/opt/saltworks/saltminer/scripts/RunPythonAdapter.sh",
      "PythonAgentService": "/opt/saltworks/saltminer/scripts/agentservice.sh"
    }
  },
  "LogConfig": {
    "Serilog": {
      "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
      "MinimumLevel": {
        "Default": "Debug",
        "Override": {
          "Microsoft": "Warning",
          "System.Net": "Warning",
          "Quartz":  "Warning"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:g} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}",
            "restricteDtoMinimumLevel": "Information"
          }
        },
        {
          "Name": "Logger",
          "Args": {
            "configureLogger": {
              "WriteTo": [
                {
                  "Name": "File",
                  "Args": {
                    "path": "/opt/saltworks/saltminer/logs/smsm-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": "7",
                    "outputTemplate": "[{Timestamp:g} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}",
                    "formatter-": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog",
                    "restricteDtoMinimumLevel": "Information"
                  }
                }
              ]
            }
          }
        }
      ],
      "Enrich": [ "FromLogContext", "WithExceptionDetails", "WithThreadId" ],
      "Properties": {
        "Application": "ServiceManager"
      }
    }
  }
}