{
  "ManagerConfig": {
    "EncryptionKey": "",
    "EncryptionIv": "",
    "DataApiBaseUrl": "http://api:5000",
    "DataApiVerifySsl": "true",
    "DataApiKey": "managersecret",
    "DataApiKeyHeader": "Authorization"
  },
  "LogConfig": {
    "Serilog": {
      "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
      "MinimumLevel": {
        "Default": "Debug",
        "Override": {
          "Microsoft": "Warning",
          "System.Net": "Warning",
          "Saltworks.Utility.ApiHelper.ApiClient": "Warning",
          "ApiHelper": "Warning"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:g} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}",
            "restrictedToMinimumLevel": "Information"
          }
        },
        {
          "Name": "Logger",
          "Args": {
            "configureLogger": {
              "WriteTo": [
                {
                  "Name": "File",
                  "Args": {
                    "path": "/opt/saltworks/saltminer/logs/smmgr-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": "7",
                    "outputTemplate": "[{Timestamp:g} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}",
                    "formatter-": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog",
                    "restrictedToMinimumLevel": "Information"
                  }
                }
              ]
            }
          }
        }
      ],
      "Enrich": [ "FromLogContext", "WithExceptionDetails", "WithThreadId" ],
      "Properties": {
        "Application": "Manager"
      }
    }
  }
}