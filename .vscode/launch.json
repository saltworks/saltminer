{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Saltworks.SaltMiner.DataApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Saltworks.SaltMiner.DataApi/Saltworks.SaltMiner.DataApi/bin/Debug/net8.0/Saltworks.SaltMiner.DataApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Saltworks.SaltMiner.DataApi/Saltworks.SaltMiner.DataApi",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SALTMINER_ENVIRONMENT": "Local",
        "SALTMINER_API_CONFIG_PATH": "C:\\Source\\saltMiner-internal\\config\\api"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
