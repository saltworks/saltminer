{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-dataapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Saltworks.SaltMiner.DataApi/Saltworks.SaltMiner.DataApi.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {    
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-uiapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Saltworks.SaltMiner.Ui.Api/Saltworks.SaltMiner.Ui.Api.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
