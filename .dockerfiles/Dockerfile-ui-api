FROM mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64

LABEL base-image="mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64"
LABEL vendor="Saltworks Security, LLC"

ENV APP_ROOT=/opt/saltworks/saltminer
WORKDIR ${APP_ROOT}/app/ui-api

ARG ARTIFACT_PATH=.
ENV ARTIFACT_PATH=$ARTIFACT_PATH
COPY $ARTIFACT_PATH .

RUN mkdir -p ${APP_ROOT}/config \
  && mkdir -p ${APP_ROOT}/logs

ENV DOTNET_PRINT_TELEMETRY_MESSAGE=false
ENV SALTMINER_CONFIG_PATH=${APP_ROOT}/config/ui-api/
ENV USER=saltminer
ENV GROUPNAME=$USER
ENV UID=10000
ENV GID=10001

# curl is used for healthcheck.
RUN apk add --no-cache curl \
  && mkdir -p ${APP_ROOT}/config \
  && mkdir -p ${APP_ROOT}/logs \
  && mkdir -p ${APP_ROOT}/ui-files

RUN addgroup \
    --gid "$GID" \
    "$GROUPNAME" \
  &&  adduser \
    --disabled-password \
    --gecos "" \
    --home "$(pwd)" \
    --ingroup "$GROUPNAME" \
    --no-create-home \
    --uid "$UID" \
    $USER

RUN chown -R $USER:$GROUPNAME . \
  && chown -R $USER:$GROUPNAME ${APP_ROOT}/config \
  && chown -R $USER:$GROUPNAME ${APP_ROOT}/ui-files \
  && chown -R $USER:$GROUPNAME ${APP_ROOT}/logs

EXPOSE 5001

USER $USER

ENTRYPOINT ["/usr/bin/dotnet", "/usr/share/saltworks/saltminer-3.0.0/ui-api/Saltworks.SaltMiner.Ui.Api.dll"]
