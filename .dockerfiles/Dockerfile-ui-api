FROM mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64

LABEL base-image="mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64"
LABEL vendor="Saltworks Security, LLC"

smapp=/opt/saltworks/saltminer/app
smcfg=/opt/saltworks/saltminer/config
smlog=/opt/saltworks/saltminer/logs
smfiles=/opt/saltworks/saltminer/ui-files
WORKDIR ${smapp}/ui-api

ARG ARTIFACT_PATH=.
ENV ARTIFACT_PATH=$ARTIFACT_PATH
COPY $ARTIFACT_PATH .

RUN mkdir -p ${smcfg} \
  && mkdir -p ${smlog}

ENV DOTNET_PRINT_TELEMETRY_MESSAGE=false
ENV SALTMINER_CONFIG_PATH=${smcfg}/ui-api/
ENV USER=saltminer
ENV GROUPNAME=$USER
ENV UID=10000
ENV GID=10001

# curl is used for healthcheck.
RUN apk add --no-cache curl \
  && mkdir -p ${smcfg} \
  && mkdir -p ${smlog} \
  && mkdir -p ${smfiles}

RUN addgroup \
    --gid "$GID" \
    "$GROUPNAME" \
  &&  adduser \
    --disabled-password \
    --gecos "" \
    --home "$(pwd)" \
    --ingroup "$GROUPNAME" \
    --no-create-home \
    --uid "$UID" \
    $USER

RUN chown -R $USER:$GROUPNAME . \
  && chown -R $USER:$GROUPNAME ${smcfg} \
  && chown -R $USER:$GROUPNAME ${smfiles} \
  && chown -R $USER:$GROUPNAME ${smlog} \

EXPOSE 5001

USER $USER

ENTRYPOINT ["/usr/bin/dotnet", "/usr/share/saltworks/saltminer-3.0.0/ui-api/Saltworks.SaltMiner.Ui.Api.dll"]
