# syntax=docker/dockerfile:1

# Pin to current nginx stable release (1.28.3)
FROM nginx:1.28.3

# Copy SaltMiner nginx configuration files from the repo
# Source: github.com/saltworks/saltminer/nginx
COPY Saltworks.SaltMiner.Nginx/nginx.conf    /etc/nginx/nginx.conf
COPY Saltworks.SaltMiner.Nginx/saltminer.crt /etc/nginx/saltminer.crt
COPY Saltworks.SaltMiner.Nginx/saltminer.key /etc/nginx/saltminer.key

# Restrict permissions on the private key
RUN chmod 600 /etc/nginx/saltminer.key

# Expose standard HTTP and HTTPS ports
EXPOSE 80 443
