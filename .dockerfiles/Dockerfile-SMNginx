# syntax=docker/dockerfile:1

# Pin to current nginx stable release (1.28.3)
FROM nginx:1.28.3

# Copy SaltMiner nginx configuration files from the repo
COPY Saltworks.SaltMiner.Nginx/nginx.conf    /etc/nginx/nginx.conf
COPY Saltworks.SaltMiner.Nginx/saltminer.crt /etc/nginx/saltminer.crt
COPY Saltworks.SaltMiner.Nginx/saltminer.key /etc/nginx/saltminer.key
COPY ./artifacts/dist/ui-web/smpgui /usr/share/saltworks/saltminer-3.0.0/ui-web/smpgui

# Bake the same files into the defaults bundle (used to seed an empty bind mount)
COPY Saltworks.SaltMiner.Nginx/nginx.conf    /etc/nginx/defaults/nginx.conf
COPY Saltworks.SaltMiner.Nginx/saltminer.crt /etc/nginx/defaults/saltminer.crt
COPY Saltworks.SaltMiner.Nginx/saltminer.key /etc/nginx/defaults/saltminer.key

COPY Saltworks.SaltMiner.Nginx/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Restrict permissions on the private key
RUN chmod 600 /etc/nginx/saltminer.key

# Expose standard HTTP and HTTPS ports
EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
