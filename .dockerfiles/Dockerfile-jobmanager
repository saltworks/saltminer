FROM mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64

LABEL base-image="mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64"
LABEL vendor="Saltworks Security, LLC"

ENV APP_ROOT=/opt/saltworks/saltminer
ENV DOTNET_PRINT_TELEMETRY_MESSAGE=false
ENV SALTMINER_CONFIG_PATH=${APP_ROOT}/config/jobmanager/
ENV USER=saltminer
ENV GROUPNAME=$USER
ENV UID=10000
ENV GID=10001

WORKDIR ${APP_ROOT}/app/jobmanager

ARG ARTIFACT_PATH=.
ENV ARTIFACT_PATH=$ARTIFACT_PATH
COPY $ARTIFACT_PATH .

RUN addgroup \
    --gid "$GID" \
    "$GROUPNAME" \
  && adduser \
    --disabled-password \
    --gecos "" \
    --home "$(pwd)" \
    --ingroup "$GROUPNAME" \
    --no-create-home \
    --uid "$UID" \
    $USER \
  && mkdir -p ${APP_ROOT}/config/jobmanager \
  && mkdir -p ${APP_ROOT}/logs \
  && chown -R $USER:$GROUPNAME . \
  && chown -R $USER:$GROUPNAME ${APP_ROOT}/config \
  && chown -R $USER:$GROUPNAME ${APP_ROOT}/logs

EXPOSE 5002

USER $USER

ENTRYPOINT ["/usr/bin/dotnet", "/opt/saltworks/saltminer/app/jobmanager/Saltworks.SaltMiner.JobManager.dll"]
