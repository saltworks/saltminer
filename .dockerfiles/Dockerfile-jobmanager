FROM mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64

LABEL base-image="mcr.microsoft.com/dotnet/aspnet:8.0.20-alpine3.22-amd64"
LABEL vendor="Saltworks Security, LLC"

WORKDIR /usr/share/saltworks/saltminer-3.0.0/jobmanager

# Native deps for Syncfusion DocIORenderer -> SkiaSharp (DOCX->PDF rendering).
# The alpine base ships no font libraries; without these libSkiaSharp.so fails to
# load (libfontconfig.so.1 missing), surfacing as a SkiaSharp.SKImageInfo
# TypeInitializationException during PDF report generation. ttf-dejavu provides
# fallback fonts for substitution.
RUN apk add --no-cache fontconfig freetype ttf-dejavu

ARG ARTIFACT_PATH=.
ARG smapp=/usr/share/saltworks
ARG smapp3=${smapp}/saltminer-3.0.0
ARG smcfg=/etc/saltworks
ARG smcfg3=${smcfg}/saltminer-3.0.0
ARG smlog=/var/log/saltworks
ARG smlog3=${smlog}/saltminer-3.0.0

ENV ARTIFACT_PATH=$ARTIFACT_PATH
RUN mkdir -p ${smcfg3}/jobmanager/report-templates && \
    mkdir -p ${smlog3}

COPY  $ARTIFACT_PATH .

RUN mv ${smapp3}/jobmanager/JobManagerSettings.json ${smcfg3}/jobmanager/ && \
    mv ${smapp3}/jobmanager/Template/Saltworks ${smcfg3}/jobmanager/report-templates/

ENV DOTNET_PRINT_TELEMETRY_MESSAGE=false
ENV SALTMINER_JOBMANAGER_CONFIG_PATH=/etc/saltworks/saltminer-3.0.0/jobmanager/

ENTRYPOINT ["/usr/bin/dotnet", "/usr/share/saltworks/saltminer-3.0.0/jobmanager/Saltworks.SaltMiner.JobManager.dll"]
