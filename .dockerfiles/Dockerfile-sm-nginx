# syntax=docker/dockerfile:1
FROM nginx:1.28.3

ENV APP_ROOT=/opt/saltworks/saltminer

# UI web artifacts
COPY ./artifacts/dist/ui-web/smpgui ${APP_ROOT}/app/ui-web/smpgui

# Defaults bundle — seeded to customer dir on first run
COPY Saltworks.SaltMiner.Nginx/nginx.conf    /etc/nginx-defaults/nginx.conf
COPY Saltworks.SaltMiner.Nginx/saltminer.crt /etc/nginx-defaults/saltminer.crt
COPY Saltworks.SaltMiner.Nginx/saltminer.key /etc/nginx-defaults/saltminer.key

# Create the customer-facing directory so it exists even without a bind mount
RUN mkdir -p ${APP_ROOT}/config/nginx

COPY Saltworks.SaltMiner.Nginx/docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh \
    && chmod 600 /etc/nginx-defaults/saltminer.key

EXPOSE 80 443
ENTRYPOINT ["/docker-entrypoint.sh"]
