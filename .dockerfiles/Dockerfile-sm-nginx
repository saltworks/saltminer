# syntax=docker/dockerfile:1
FROM nginx:1.28.3

ENV APP_ROOT=/opt/saltworks/saltminer

# UI web artifacts
COPY ./artifacts/dist/ui-web/smpgui ${APP_ROOT}/app/ui-web/smpgui

# Defaults bundle — seeded to customer dir on first run
COPY Saltworks.SaltMiner.Nginx/nginx.conf    /etc/nginx-defaults/nginx.conf
COPY Saltworks.SaltMiner.Nginx/saltminer.crt /etc/nginx-defaults/saltminer.crt
COPY Saltworks.SaltMiner.Nginx/saltminer.key /etc/nginx-defaults/saltminer.key
COPY Saltworks.SaltMiner.Nginx/docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh \
    && chmod 600 /etc/nginx-defaults/saltminer.key

# `podman stop` sends this to PID 1.  The nginx base image sets STOPSIGNAL SIGQUIT
# (graceful shutdown) which waits for active proxy connections (Kibana keepalive/
# websockets) to drain; with no worker_shutdown_timeout that hangs until the ~10s
# stop timeout -> SIGKILL.  SIGTERM = nginx fast shutdown, so `stop` returns promptly.
STOPSIGNAL SIGTERM

# exec form: the entrypoint `exec`s nginx, so nginx is PID 1 and STOPSIGNAL reaches
# it directly (shell form would interpose /bin/sh -c and can swallow the signal).
ENTRYPOINT ["/docker-entrypoint.sh"]
