{
  "ApiConfig": {
    "ElasticUsername": "elastic",
    "ElasticPassword": "",
    "ElasticHttpScheme": "http",
    "ElasticHost": [ "localhost" ],
    "ElasticPort": 9200,
    "ElasticSingleNodeCluster": false,
    "ApiKeys": {
      "adminsecret": "Admin",
      "agentsecret": "Agent",
      "managersecret": "Manager",
      "pentestsecret": "Pentester",
      "jobmanagersecret": "JobManager",
      "servicemanagersecret": "ServiceManager"
    },
    "NginxScheme": "https",
    "VerifySsl": true,
    "ElasticBackupLocation": "./Backups",
    "TempFileLocation": "./Temp",
    "EncryptionKey": "",
    "EncryptionIv": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning"

      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:g} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/opt/saltworks/saltminer/logs/smapi-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": "7",
          "outputTemplate": "[{Timestamp:g} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}",
          "formatter-": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}